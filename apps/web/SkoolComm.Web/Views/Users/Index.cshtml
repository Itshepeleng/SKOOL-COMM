@{
    ViewData["Title"] = "Manage Users";
}

<div class="page-header">

    <div>
        <h2>Manage Users</h2>
        <p>Manage teachers, parents and administrators.</p>
    </div>

    <button type="button"
            class="btn-primary"
            id="addUserButton">
        + Add User
    </button>

</div>


<!-- USER SUMMARY -->

<div class="stats-grid users-stats">

    <div class="stat-card">

        <div class="stat-icon stat-icon-green">
            👥
        </div>

        <div class="stat-content">

            <span>Total Users</span>

            <strong id="totalUsers">
                320
            </strong>

        </div>

    </div>


    <div class="stat-card">

        <div class="stat-icon stat-icon-blue">
            👨‍🏫
        </div>

        <div class="stat-content">

            <span>Teachers</span>

            <strong id="teacherCount">
                35
            </strong>

        </div>

    </div>


    <div class="stat-card">

        <div class="stat-icon stat-icon-orange">
            👨‍👩‍👧
        </div>

        <div class="stat-content">

            <span>Parents</span>

            <strong id="parentCount">
                250
            </strong>

        </div>

    </div>


    <div class="stat-card">

        <div class="stat-icon stat-icon-purple">
            ✓
        </div>

        <div class="stat-content">

            <span>Administrators</span>

            <strong id="adminCount">
                3
            </strong>

        </div>

    </div>

</div>


<!-- ADD USER FORM -->

<div class="card user-form-card">

    <div class="card-header">

        <div>
            <h3>Add New User</h3>
            <p>Create a new school user account.</p>
        </div>

    </div>


    <div class="user-form">

        <div class="form-group">

            <label for="userName">
                Full Name
            </label>

            <input type="text"
                   id="userName"
                   placeholder="Enter full name" />

        </div>


        <div class="form-group">

            <label for="userEmail">
                Email / Username
            </label>

            <input type="text"
                   id="userEmail"
                   placeholder="Enter email or username" />

        </div>


        <div class="form-group">

            <label for="userRole">
                Role
            </label>

            <select id="userRole">

                <option value="">
                    Select role
                </option>

                <option value="teacher">
                    Teacher
                </option>

                <option value="parent">
                    Parent
                </option>

                <option value="admin">
                    Administrator
                </option>

            </select>

        </div>

    </div>


    <div class="user-actions">

        <button type="button"
                class="btn-primary"
                id="saveUserButton">
            Create User
        </button>

    </div>

</div>


<!-- USERS TABLE -->

