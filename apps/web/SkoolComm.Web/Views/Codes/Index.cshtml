@model List<SkoolComm.Domain.Models.LearnerCodeItem>
@{
    ViewData["Title"] = "Learner Codes";
    int missing = Model.Count(m => m.Code == null);

    string successMsg = TempData["Success"]?.ToString() ?? "";
    string errorMsg = (TempData["Error"]?.ToString() ?? "") + (ViewBag.Error as string ?? "");
    string toastClass = errorMsg != "" ? "toast error" : successMsg != "" ? "toast success" : "toast success hidden";
    string toastText = errorMsg != "" ? errorMsg : successMsg;
}

<div class="page-wide stack" id="codesPage">

    <div id="codeToast" class="@toastClass"><span>@toastText</span></div>

    <div class="row-between">
        <div class="search-wrap">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="6.5" cy="6.5" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M11 11l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            <input type="text" id="codeSearch" class="input" style="padding-left:36px;width:240px;background:#fff;" placeholder="Search learners..." />
        </div>

        <form method="post" asp-controller="Codes" asp-action="GenerateMissing">
            <button type="submit" class="btn btn-primary btn-sm" @(missing == 0 ? "disabled" : "")>
                Generate missing codes (@missing)
            </button>
        </form>
    </div>

    <p class="small muted">
        Give each family their learner's code. Each code works for 2 guardians and never expires.
        Parents enter it in the app to link to the learner automatically.
    </p>

    <div class="table-wrap">
        <table class="tbl">
            <thead>
                <tr><th>Learner</th><th>Class</th><th>Code</th><th>Used</th><th></th></tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="center faint">No learners found.</td></tr>
                }
                @foreach (var l in Model)
                {
                    bool full = l.Code != null && l.Uses >= l.MaxUses;
                    <tr class="code-row" data-search="@((l.FirstName + " " + l.LastName + " " + l.Class).ToLowerInvariant())">
                        <td style="font-weight:600;">@l.LastName, @l.FirstName</td>
                        <td class="muted">@l.Grade · @l.Class</td>
                        <td>
                            @if (l.Code == null) { <span class="faint">No code yet</span> }
                            else { <span class="code-chip">@l.Code</span> }
                        </td>
                        <td>
                            @if (l.Code != null)
                            {
                                <span class="badge @(full ? "badge-orange" : "badge-green")">@l.Uses / @l.MaxUses</span>
                            }
                        </td>
                        <td>
                            <div class="row gap-3" style="justify-content:flex-end;">
                                @if (l.Code == null)
                                {
                                    <button type="button" class="link-btn gen-btn" data-id="@l.LearnerId" data-name="@l.LastName, @l.FirstName" data-replace="false">Generate</button>
                                }
                                else
                                {
                                    <button type="button" class="link-btn copy-btn" data-code="@l.Code">Copy</button>
                                    <button type="button" class="link-btn danger gen-btn" data-id="@l.LearnerId" data-name="@l.LastName, @l.FirstName" data-replace="true">Replace</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <form method="post" asp-controller="Codes" asp-action="Generate" id="genForm">
        <input type="hidden" name="learnerId" id="genId" />
        <input type="hidden" name="replace" id="genReplace" />
    </form>
</div>

@section Scripts {
    <script src="~/js/codes.js" asp-append-version="true"></script>
}