@model List<SkoolComm.Domain.Models.Announcement>
@using System.Globalization
@{
    ViewData["Title"] = "Announcements";
    var inv = CultureInfo.InvariantCulture;

    string successMsg = TempData["Success"]?.ToString() ?? "";
    string errorMsg = (TempData["Error"]?.ToString() ?? "") + (ViewBag.Error as string ?? "");
    string toastClass = errorMsg != "" ? "toast error"
                      : successMsg != "" ? "toast success"
                      : "toast success hidden";
    string toastText = errorMsg != "" ? errorMsg : successMsg;

    string Preview(string text) =>
        text.Length > 140 ? text.Substring(0, 140).TrimEnd() + "…" : text;
}

<style>
    .announcement-open {
        display: block;
        width: 100%;
        border: 0;
        color: inherit;
        font: inherit;
        text-align: left;
        cursor: pointer;
    }

        .announcement-open:hover {
            filter: brightness(0.97);
        }

    .announcement-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 8px;
        margin-bottom: 4px;
    }

    .announcement-dialog {
        width: min(720px, calc(100vw - 32px));
        max-height: 86vh;
        margin: auto;
        padding: 0;
        overflow-y: auto;
        border: 0;
        border-radius: 16px;
        color: inherit;
        background: white;
        box-shadow: 0 20px 60px rgb(0 0 0 / 25%);
    }

        .announcement-dialog::backdrop {
            background: rgb(15 23 42 / 58%);
            backdrop-filter: blur(2px);
        }

    .announcement-dialog-header {
        position: sticky;
        top: 0;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        padding: 22px 24px;
        border-bottom: 1px solid #e5e7eb;
        background: white;
    }

    .announcement-dialog-body {
        padding: 22px 24px 28px;
    }

    .announcement-message {
        white-space: pre-line;
        overflow-wrap: anywhere;
        line-height: 1.7;
    }

    .announcement-close {
        flex-shrink: 0;
    }

    @@media (max-width: 600px) {
        .announcement-dialog {
            width: calc(100vw - 20px);
            max-height: 90vh;
            border-radius: 12px;
        }

        .announcement-dialog-header,
        .announcement-dialog-body {
            padding: 18px;
        }
    }
</style>

<div class="page-wide stack" id="annPage">

    <div id="annToast" class="@toastClass">
        <span id="annToastText">@toastText</span>
    </div>

    <div class="grid-5">

        <!-- ============ Create form ============ -->
        <form class="card card-lg col-span-3 stack" id="annForm" method="post"
              asp-controller="Announcements" asp-action="Create">

            <h3 style="margin-bottom:0;">Create New Announcement</h3>

            <div>
                <label class="lbl" for="annTitle">Title</label>
                <input type="text" id="annTitle" name="title" class="input"
                       placeholder="Announcement title..." maxlength="255" />
            </div>

            <div>
                <label class="lbl">Audience</label>
                <div class="row gap-2 wrap" id="audienceChips">
                    <button type="button" class="chip active" data-audience="All Parents">All Parents</button>
                    <button type="button" class="chip" data-audience="Grade 5">Grade 5</button>
                    <button type="button" class="chip" data-audience="Grade 6">Grade 6</button>
                    <button type="button" class="chip" data-audience="Teachers Only">Teachers Only</button>
                </div>
                <input type="hidden" name="targetAudience" id="annAudience" value="All Parents" />
            </div>

            <div>
                <label class="lbl" for="annMessage">Message</label>
                <textarea id="annMessage" name="content" class="textarea" rows="6"
                          placeholder="Dear Parents,&#10;&#10;Write your announcement message here..."></textarea>
                <div class="small faint" style="text-align:right;margin-top:4px;">
                    <span id="charCount">0</span> characters
                </div>
            </div>

            <div class="row gap-3" style="justify-content:flex-end;">
                <button type="button" id="annClear" class="btn btn-outline">Clear</button>
                <button type="button" id="annSend" class="btn btn-primary" disabled>Send</button>
            </div>
        </form>

        <!-- ============ Recent announcements ============ -->
        <div class="card col-span-2">
            <h3 style="margin-bottom:16px;">Recent Announcements</h3>

            <div class="stack-md">
                @if (Model.Count == 0)
                {
                    <p class="small faint">No announcements yet. Send the first one.</p>
                }

                @foreach (var a in Model)
                {
                    var dialogId = $"announcementDialog_{a.AnnouncementId}";
                    var titleId = $"announcementTitle_{a.AnnouncementId}";

                    <button type="button"
                            class="record-box announcement-open"
                            data-dialog-id="@dialogId"
                            aria-haspopup="dialog"
                            aria-controls="@dialogId">
                        <span class="announcement-heading">
                            <span style="font-size:14px;font-weight:600;line-height:1.35;">
                                @a.Title
                            </span>
                            <span class="badge badge-green" style="flex-shrink:0;">
                                @a.TargetAudience
                            </span>
                        </span>

                        <span class="small muted" style="white-space:pre-line;line-height:1.5;">
                            @Preview(a.Content)
                        </span>

                        <span class="tiny faint" style="display:block;margin-top:6px;">
                            @a.DatePosted.ToString("d MMM yyyy, HH:mm", inv)
                            · Click to read full message
                        </span>
                    </button>

                    <dialog class="announcement-dialog"
                            id="@dialogId"
                            aria-labelledby="@titleId">
                        <div class="announcement-dialog-header">
                            <div>
                                <h2 id="@titleId" style="margin:0 0 10px;">
                                    @a.Title
                                </h2>
                                <span class="badge badge-green">@a.TargetAudience</span>
                                <div class="tiny faint" style="margin-top:8px;">
                                    @a.DatePosted.ToString("d MMM yyyy, HH:mm", inv)
                                </div>
                            </div>

                            <button type="button"
                                    class="btn btn-outline announcement-close"
                                    data-close-dialog>
                                Close
                            </button>
                        </div>

                        <div class="announcement-dialog-body">
                            <p class="small muted announcement-message">@a.Content</p>
                        </div>
                    </dialog>
                }
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/announcements.js" asp-append-version="true"></script>

    <script>
        document.querySelectorAll("[data-dialog-id]").forEach(function (button) {
            button.addEventListener("click", function () {
                const dialog = document.getElementById(button.dataset.dialogId);
                if (dialog instanceof HTMLDialogElement) {
                    dialog.showModal();
                }
            });
        });

        document.querySelectorAll(".announcement-dialog").forEach(function (dialog) {
            dialog.querySelector("[data-close-dialog]")?.addEventListener("click", function () {
                dialog.close();
            });

            dialog.addEventListener("click", function (event) {
                if (event.target === dialog) {
                    dialog.close();
                }
            });
        });
    </script>
}