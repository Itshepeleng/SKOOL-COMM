@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<style>
    :root{--accent:#0d6efd}
    .fullscreen-center{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:2rem;background:linear-gradient(135deg,#f8f9ff 0%, #e9f2ff 100%);}
    .coming-card{background:rgba(255,255,255,0.90);border-radius:1rem;padding:2rem 2.5rem;box-shadow:0 10px 30px rgba(13,110,253,0.08);text-align:center;max-width:820px;width:100%;}
    .icon-circle{width:96px;height:96px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;background:linear-gradient(180deg,var(--accent),#5aa0ff);color:white;font-size:2.5rem;box-shadow:0 6px 18px rgba(13,110,253,0.18)}
    .pulse{animation:pulse 2s infinite}
    @@keyframes pulse{0%{transform:scale(1);opacity:1}50%{transform:scale(1.06);opacity:0.95}100%{transform:scale(1);opacity:1}}
    .coming-title{font-size:1.75rem;font-weight:700;color:#0b2b4a;margin-bottom:.25rem}
    .coming-sub{color:#3b556e;margin-bottom:1rem}
    .cta-badge{display:inline-block;background:#e9f5ff;color:var(--accent);padding:.45rem 1rem;border-radius:999px;font-weight:600;border:1px solid rgba(13,110,253,0.12)}
    .small-note{color:#6c757d;margin-top:1rem}
    @@media (min-width: 768px){.coming-title{font-size:2.25rem}}
</style>

<div class="fullscreen-center">
    <div class="coming-card">
        <div class="icon-circle pulse">
            <i class="bi bi-building-fill"></i>
        </div>

        <h1 class="coming-title">Wilgehof Primary School</h1>
        <p class="coming-sub mb-3">Teacher &amp; Administrator Web Portal</p>

        <div class="mb-3">
            <span class="cta-badge">🚧 System Under Construction</span>
        </div>

        <h2 class="h3 fw-bold text-dark mb-2">Coming Soon</h2>
        <p class="text-muted mb-3">We're putting the finishing touches on Skool-Comm. The portal will centralize communications for teachers, parents, and administrators.</p>

        <!--<div class="d-flex justify-content-center gap-2">
            <a class="btn btn-primary btn-lg disabled" href="#" tabindex="-1" aria-disabled="true">Notify Me (coming soon)</a>
            <a class="btn btn-outline-secondary btn-lg" href="/Privacy">Privacy</a>
        </div>-->

        <p class="small-note small mt-3">Skool-Comm Centralized Communication Management System</p>
    </div>
</div>
