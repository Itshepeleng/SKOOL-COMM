@using Microsoft.AspNetCore.Mvc.Razor
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SkoolComm</title>
    <link rel="stylesheet" href="~/css/skoolcom.css" asp-append-version="true" />
  </head>
  <body>
    <div class="container">
      <header class="topbar">
        <div class="brand">SkoolComm — Wilgehof Primary</div>
        <div class="actions">
          <a class="btn" asp-page="/Dashboard">Dashboard</a>
          <a class="btn" asp-page="/Profile">Profile</a>
          <form method="post" asp-page-handler="Logout" style="display:inline">
            <button type="submit" class="btn">Logout</button>
          </form>
        </div>
      </header>

      <div class="layout">
        <aside class="sidebar">
          <a class="btn" asp-page="/Dashboard">Overview</a>
          <a class="btn" asp-page="/Attendance" data-screen="attendance">Attendance</a>
          <a class="btn" asp-page="/Behavioural" data-screen="behavioural">Behaviour</a>
          <a class="btn" asp-page="/Results" data-screen="results">Results</a>
          <a class="btn" asp-page="/Announcements" data-screen="announcements">Announcements</a>
        </aside>

        <main>
          @RenderBody()
        </main>
      </div>
    </div>

    <script src="~/js/skoolcomm.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
  </body>
</html>
