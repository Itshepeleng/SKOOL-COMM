<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>5e84d278-2c15-40f5-add9-0e0c475451f0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- These projects are consumed through the compiled DLL references below.
         Do not compile their nested source and generated files into the web app. -->
    <Compile Remove="SkoolComm.Domain\**\*.cs" />
    <Compile Remove="SkoolComm.Application\**\*.cs" />
    <Compile Remove="SkoolComm.Infrastructure\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SkoolComm.Domain">
      <HintPath>..\lib\SkoolComm.Domain.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SkoolComm.Application">
      <HintPath>..\lib\SkoolComm.Application.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SkoolComm.Infrastructure">
      <HintPath>..\lib\SkoolComm.Infrastructure.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Supabase">
      <HintPath>..\lib\Supabase.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Supabase.Core">
      <HintPath>..\lib\Supabase.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Supabase.Gotrue">
      <HintPath>..\lib\Supabase.Gotrue.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Supabase.Realtime">
      <HintPath>..\lib\Supabase.Realtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Supabase.Storage">
      <HintPath>..\lib\Supabase.Storage.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Supabase.Postgrest">
      <HintPath>..\lib\Supabase.Postgrest.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Views\Results\" />
  </ItemGroup>

</Project>
